-- Forsaken | Auto Generator (mini GUI with repair speed slider)
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local CoreGui = game:GetService("CoreGui")
local UIS = game:GetService("UserInputService")

local plr = Players.LocalPlayer
local WS = workspace

local enabled = false
local speedUp = false
local isFixing = false
local rng = Random.new()

local CONFIG = {
    Distance = 6.7,
    Cooldown = 4,
    MinCooldown = 1.5,
    MaxCooldown = 15,
    Step = 0.25,
    NearCheckDist = 32,
    Variance = 0.1,
}

local GameMap
local function getMap()
    if GameMap and GameMap.Parent then return GameMap end
    local map = WS:FindFirstChild("Map")
    local ingame = map and map:FindFirstChild("Ingame")
    GameMap = ingame and ingame:FindFirstChild("Map")
    return GameMap
end

local function isPlayerNear()
    local char = plr.Character
    if not char then return false end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    for _, v in ipairs(Players:GetPlayers()) do
        if v ~= plr and v.Character then
            local r = v.Character:FindFirstChild("HumanoidRootPart")
            if r and (r.Position - root.Position).Magnitude < CONFIG.NearCheckDist then
                return true
            end
        end
    end
    return false
end

local function findGenerators()
    local map = getMap()
    if not map then return {} end
    local out = {}
    local ok, q = pcall(function()
        return map:QueryDescendants("Model#Generator:has(#Main)")
    end)
    if ok and q and #q > 0 then
        for _, v in ipairs(q) do table.insert(out, v) end
        return out
    end
    for _, d in ipairs(map:GetDescendants()) do
        if d:IsA("Model") and d.Name == "Generator" and d:FindFirstChild("Main") then
            table.insert(out, d)
        end
    end
    return out
end

local function puzzleActive()
    local pg = plr.PlayerGui
    return pg and pg:FindFirstChild("PuzzleUI") ~= nil
end

local function getCooldown()
    local base = CONFIG.Cooldown
    if speedUp and not isPlayerNear() and base > 2 then
        base = CONFIG.MinCooldown
    end
    return rng:NextNumber(base - CONFIG.Variance * base, base + CONFIG.Variance * base)
end

local function fixGenerator(gen)
    local char = plr.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root or root.Anchored then return end

    local remotes = gen:FindFirstChild("Remotes")
    local progress = gen:FindFirstChild("Progress")
    if not remotes or not progress then return end
    local remote = remotes:FindFirstChildOfClass("RemoteEvent")
    if not remote then return end

    if not puzzleActive() then return end

    isFixing = true
    pcall(function()
        while enabled do
            if not gen.Parent then break end
            if not root.Parent then break end
            local main = gen:FindFirstChild("Main")
            if not main then break end
            if (root.Position - main.Position).Magnitude > CONFIG.Distance then break end
            if not puzzleActive() then break end
            if root.Anchored then break end

            task.wait(getCooldown())

            if not enabled then break end
            if not gen.Parent then break end
            if not puzzleActive() then break end

            pcall(function() remote:FireServer() end)
        end
    end)
    isFixing = false
end

task.spawn(function()
    while task.wait() do
        if not enabled or isFixing then continue end
        local char = plr.Character
        if not char then continue end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root or root.Anchored then continue end
        if not puzzleActive() then continue end

        for _, gen in ipairs(findGenerators()) do
            local main = gen:FindFirstChild("Main")
            if main and (main.Position - root.Position).Magnitude < CONFIG.Distance then
                task.spawn(fixGenerator, gen)
                break
            end
        end
    end
end)

