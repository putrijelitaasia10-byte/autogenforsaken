local function makeDrag(handle)
    local draggingPanel, dragStart, startPos
    handle.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            if handle == panel then
                local mx, my = i.Position.X, i.Position.Y
                local tp = track.AbsolutePosition
                local ts = track.AbsoluteSize
                if mx >= tp.X and mx <= tp.X + ts.X and my >= tp.Y and my <= tp.Y + ts.Y then
                    return
                end
            end
            draggingPanel = true
            dragStart = i.Position
            startPos = handle.Position
            i.Changed:Connect(function()
                if i.UserInputState == Enum.UserInputState.End then draggingPanel = false end
            end)
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if not draggingPanel then return end
        if i.UserInputType == Enum.UserInputType.MouseMovement
        or i.UserInputType == Enum.UserInputType.Touch then
            local d = i.Position - dragStart
            handle.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
end

